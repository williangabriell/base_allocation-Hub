        <field/>
        <global>true</global>
        <isolate_script>true</isolate_script>
        <messages/>
        <name>Validate Unique Manager</name>
        <order/>
        <script><![CDATA[function onSubmit() {
    // 1. Captura o ID do gerente preenchido no formulário
    var manager = g_form.getValue('manager');
    
    // Se o campo de gerente estiver vazio, deixa o ServiceNow seguir com o fluxo padrão
    if (manager == '') {
        return true;
    }

    // Captura o sys_id da base atual (será vazio se for um novo registro)
    var baseId = g_form.getUniqueValue();
    
    // 2. Instancia o GlideAjax apontando exatamente para o seu Script Include 'CheckManager'
    var ga = new GlideAjax('CheckManager');
    ga.addParam('sysparm_name', 'checkDuplicateManager'); // Nome da função dentro do Script Include
    ga.addParam('sysparm_manager_id', manager);          // Passa o ID do gerente selecionado
    ga.addParam('sysparm_base_id', baseId);              // Passa o ID da base para o tratamento de Update
    
    // 3. Executa a chamada síncrona (trava o envio e aguarda a resposta do servidor)
    ga.getXMLWait();
    var answer = ga.getAnswer();
    
    // 4. Trata o retorno do servidor
    if (answer == 'duplicate') {
        // Exibe a barra vermelha de erro no topo do formulário
        g_form.addErrorMessage('Operação cancelada: Este usuário já é gerente de outra base cadastrada. Um gerente não pode gerir duas bases diferentes.');
        
        // Retornar 'false' é o que impede o formulário de ser salvo e mantém o usuário na tela
        return false; 
    }
    
    // Se retornar 'ok', permite que o registro seja inserido/atualizado com sucesso
    return true; 
}]]></script>
