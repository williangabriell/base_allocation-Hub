        <script><![CDATA[function onLoad() {
    var baseValue = g_form.getValue('base');
    if (!baseValue) return;

    if (g_form.isNewRecord()) {
        g_form.setValue('state', '3');
        g_form.setReadOnly('state', true);
    }

    g_form.getReference('base', function(baseGR) {
        if (baseGR && baseGR.manager) {
            g_form.setValue('manager', baseGR.manager);
            g_form.setValue('manager', baseGR.getDisplayValue('manager'));
        }
    });
}]]></script>
