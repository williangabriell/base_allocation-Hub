        <name>x_1902784_base_a_0_base_registration</name>
        <new_condition><![CDATA[// O botão New será OMITIDO (escondido) se esta condição for verdadeira
var baseId = parent.getUniqueValue();
var maxCapacity = parseInt(parent.getValue('max_capacity'), 10) || 0;

// Conta quantos registros ativos (awaiting/approved) já existem
var countGR = new GlideAggregate('x_1902784_base_a_0_base_allocation');
countGR.addQuery('base', baseId);
countGR.addQuery('state', 'IN', '2,3');
countGR.addAggregate('COUNT');
countGR.query();

var currentCount = 0;
if (countGR.next()) {
    currentCount = parseInt(countGR.getAggregate('COUNT'), 10);
}

// Retorna 'true' para OMITIR o botão se a lotação estiver atingida
answer = (currentCount >= maxCapacity);]]></new_condition>
